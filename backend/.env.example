# ── Server ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Models (ONNX, relative to backend/) ───────────────────
# Download with: python scripts/download_models.py
YOLO_MODEL_PATH=models/yolo11n.onnx
FACE_DETECT_MODEL_PATH=models/det_500m.onnx
FACE_RECOGNIZE_MODEL_PATH=models/w600k_mbf.onnx
ONNX_THREADS=0

# ── Detection defaults (editable at runtime in Settings) ──
DETECTION_CONFIDENCE=0.5
NMS_IOU_THRESHOLD=0.45
FACE_DETECTION_CONFIDENCE=0.5
FACE_RECOGNITION_THRESHOLD=0.42
MAX_DETECTION_FPS=10

# ── Limits ────────────────────────────────────────────────
MAX_FRAME_WIDTH=1280
MAX_FRAME_HEIGHT=720
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=10

# ── Storage ───────────────────────────────────────────────
DATABASE_PATH=data/gesturevision.db
UPLOAD_DIR=uploads

# Serve frontend/dist from the backend when it has been built
SERVE_FRONTEND=true
